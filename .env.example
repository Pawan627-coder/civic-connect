# ========================================================
# CIVIC CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and configure keys as needed
# ========================================================

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# (Leave blank to use the built-in 100% durable Persistent File Database Store)
MONGODB_URI=

# Application Environment
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=civic_connect_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=1d

# Admin Seed Account (Run: npm run create-admin)
ADMIN_NAME=Civic SuperAdmin
ADMIN_EMAIL=admin@civicconnect.org
ADMIN_PASSWORD=AdminSecurePass2026!

# Google Gemini AI API Key (Official Google GenAI SDK)
GEMINI_API_KEY=

# Google Maps Platform JavaScript API Key (Optional: Leaflet + OpenStreetMap works out-of-the-box)
GOOGLE_MAPS_API_KEY=

# AI Duplicate Complaint Detection Thresholds
DUPLICATE_RADIUS_METERS=100
DUPLICATE_CONFIDENCE_THRESHOLD=80

# Emergency Accident Telephony & Automated Voice Dispatch (Optional: Twilio Voice Gateway)
# If left blank, the app safely defaults to NOT_CONFIGURED status and direct 112 citizen calling
DEMO_EMERGENCY_RECEIVER_NUMBER=+919876543210
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

