# ========================================================
# CIVIC CONNECT - EXAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your secrets
# ========================================================

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/civic_connect?retryWrites=true&w=majority
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=your_long_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Optional Seed Admin Credentials (used by backend/scripts/createAdmin.js)
ADMIN_NAME=Civic SuperAdmin
ADMIN_EMAIL=admin@civicconnect.org
ADMIN_PASSWORD=AdminSecurePass2026!

# Google Gemini AI API Key (Official Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform JavaScript API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI Duplicate Complaint Detection Thresholds
DUPLICATE_RADIUS_METERS=100
DUPLICATE_CONFIDENCE_THRESHOLD=80
